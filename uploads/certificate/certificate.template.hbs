<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8" />
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap');
    
    body {
      font-family: 'Roboto', sans-serif;
      margin: 0;
      padding: 0;
      background-color: #ffffff;
    }

    .certificado {
      width: 100%;
      height: 100vh;
      padding: 40px;
      box-sizing: border-box;
      background: #ffffff;
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }

    .borda {
      position: absolute;
      top: 20px;
      left: 20px;
      right: 20px;
      bottom: 20px;
      border: 3px solid #00B1B3;
      border-radius: 8px;
    }

    .logo {
      position: absolute;
      top: 40px;
      left: 40px;
      width: 150px;
      height: auto;
    }

    .conteudo {
      text-align: center;
      z-index: 1;
      padding: 20px;
      max-width: 800px;
      margin: 0 auto;
    }

    .titulo {
      color: #002D72;
      font-size: 42px;
      font-weight: 700;
      margin-bottom: 40px;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .subtitulo {
      color: #4A4A4A;
      font-size: 22px;
      margin-bottom: 25px;
    }

    .nome {
      color: #00B1B3;
      font-size: 34px;
      font-weight: 500;
      margin: 20px 0;
    }

    .curso {
      color: #002D72;
      font-size: 26px;
      font-weight: 500;
      margin: 20px 0;
    }

    .data {
      color: #4A4A4A;
      font-size: 18px;
      margin-top: 30px;
    }

    .selo {
      width: 130px;
      height: 130px;
      border: 2px solid #00B1B3;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 30px auto;
      background: #ffffff;
      position: relative;
    }

    .selo::after {
      content: '';
      position: absolute;
      width: 120px;
      height: 120px;
      border: 1px solid #002D72;
      border-radius: 50%;
    }

    .selo-texto {
      color: #002D72;
      font-weight: 500;
      font-size: 14px;
      text-transform: uppercase;
      line-height: 1.4;
    }

    .footer {
      position: absolute;
      bottom: 40px;
      left: 0;
      right: 0;
      text-align: center;
      color: #002D72;
      font-size: 14px;
    }

    .barra-lateral {
      position: absolute;
      top: 0;
      right: 0;
      width: 8px;
      height: 100%;
      background: linear-gradient(to bottom, #00B1B3, #002D72);
    }
  </style>
</head>
<body>
  <div class="certificado">
    <div class="borda"></div>
    <div class="barra-lateral"></div>
    <img src="https://www.matera.com/wp-content/uploads/2021/06/logo-matera-1.svg" alt="Matera Logo" class="logo">
    <div class="conteudo">
      <h1 class="titulo">Certificado de Conclusão</h1>
      <p class="subtitulo">Certificamos que</p>
      <p class="nome">{{name}}</p>
      <p class="subtitulo">concluiu com êxito o curso</p>
      <p class="curso">{{course}}</p>
      <div class="selo">
        <span class="selo-texto">Certificado<br>Matera<br>2024</span>
      </div>
      <p class="data">Concluído em {{date}}</p>
    </div>
    <div class="footer">
      Matera - Transformando o futuro dos serviços financeiros
    </div>
  </div>
</body>
</html>
